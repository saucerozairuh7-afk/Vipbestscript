local _featCount = 0
local function makeFeature(parent, y, txt, cb)
    _featCount = _featCount + 1
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 258 + (_featCount % 3), 0, 36)
    b.Position = UDim2.new(0, 10 + (_featCount % 2), 0, y + (_featCount % 2))
    b.BackgroundColor3 = Color3.fromRGB(255,255,255)
    b.ZIndex = 6
    local formats = {txt.." : OFF", txt.." :OFF", txt.." - OFF", txt.." OFF"}
    local myFmt = formats[(_featCount % 4) + 1]
    b.Text = myFmt
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.TextColor3 = Color3.new(0,0,0)
    b.Parent = parent
    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0,10) c.Parent = b
    local on = false
    b.MouseButton1Click:Connect(function()
        on = not on
        if on then
            if _featCount % 4 == 0 then b.Text = txt.." : ON"
            elseif _featCount % 4 == 1 then b.Text = txt.." :ON"
            elseif _featCount % 4 == 2 then b.Text = txt.." - ON"
            else b.Text = txt.." ON" end
            b.BackgroundColor3 = Color3.fromRGB(0,255,135)
        else
            b.Text = myFmt
            b.BackgroundColor3 = Color3.fromRGB(255,255,255)
        end
        if cb then cb(on) end
    end)
    return b
end

