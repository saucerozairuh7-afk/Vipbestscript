-- REAL PLACEMENT - tulad ng sa video mo, hindi visual blocks
-- ginagamit yung placement system mismo ng TTD: ghost + range circle + R rotate + click to place
-- kaya yung ma-place mo, totoong unit: may Upgrade / Sell / Damage / Range, lumalaban talaga
local SpawnedFolder = Instance.new("Folder") SpawnedFolder.Name = "CatWareSpawned" SpawnedFolder.Parent = workspace
local spawnCount = 0
local autoSpawnOn = false
local placeMode = false
local placeGhost = nil
local placeRange = nil
local placeRot = 0
local mouse = plr:GetMouse()
local function getMousePos()
    local ok, pos = pcall(function() return mouse.Hit.Position end)
    if ok and pos then return pos end
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position + Vector3.new(0,0,-6) end
    return Vector3.new(0,5,0)
end
local function makeRangeCircle(pos, range)
    local c = Instance.new("Part")
    c.Name = "CatWareRange"
    c.Shape = Enum.PartType.Cylinder
    c.Size = Vector3.new(0.2, range*2, range*2)
    c.CFrame = CFrame.new(pos) * CFrame.Angles(0,0,math.rad(90))
    c.Transparency = 0.7
    c.Color = Color3.fromRGB(255,255,255)
    c.Anchored = true
    c.CanCollide = false
    c.CanTouch = false
    return c
end
local function tryRealPlace(name, pos)
    -- try lahat ng alam na TTD placement remote signatures - yung game mismo mag-place
    local tried = {
        function(rem) return safeFire(rem, name, CFrame.new(pos) * CFrame.Angles(0, math.rad(placeRot), 0)) end,
        function(rem) return safeFire(rem, name, pos, placeRot) end,
        function(rem) return safeFire(rem, name, pos) end,
        function(rem) return safeFire(rem, CFrame.new(pos) * CFrame.Angles(0, math.rad(placeRot), 0), name) end,
        function(rem) return safeFire(rem, name, CFrame.new(pos)) end,
    }
    local rem = nil
    pcall(function() rem = findRemote({"place", "spawn", "summon", "deploy", "tower", "placeTower"}) end)
    if not rem then return false end
    for _, fn in ipairs(tried) do
        local ok = false
        pcall(function() ok = fn(rem) end)
        if ok then return true end
        task.wait(0.1)
    end
    return false
end
local function startPlaceMode()
    if placeMode then return end
    placeMode = true
    placeRot = 0
    local name = pinili or "Future Cameraman"
    local rarity = pinilirarity or "Legendary"
    local range = 20
    pcall(function()
        for _, u in ipairs(UNITS) do if u.n == name then range = u.range or 20 break end end
    end)
    -- ghost = R15 rig, semi-transparent, tulad ng sa video mo
    pcall(function()
        placeGhost = build3DModel(name, rarity)
        for _, pp in ipairs(placeGhost:GetDescendants()) do
            if pp:IsA("BasePart") then pp.Transparency = 0.5 pp.Anchored = true pp.CanCollide = false end
        end
        placeGhost.Parent = workspace
        placeRange = makeRangeCircle(getMousePos(), range)
        placeRange.Parent = workspace
    end)
    pcall(function() DupeInfo.Text = "PLACE MODE: "..name.." - Click sa sahig para i-place | R = Rotate | X = Cancel" end)
    -- R rotate / X cancel
    local conn1, conn2, conn3
    conn1 = UIS.InputBegan:Connect(function(i, gp)
        if not placeMode then return end
        if gp then return end
        if i.KeyCode == Enum.KeyCode.R then
            placeRot = (placeRot + 45) % 360
            pcall(function() DupeInfo.Text = "Rotated: "..placeRot.." deg - Click para i-place | X = Cancel" end)
        elseif i.KeyCode == Enum.KeyCode.X then
            placeMode = false
            pcall(function() if placeGhost then placeGhost:Destroy() end if placeRange then placeRange:Destroy() end end)
            pcall(function() DupeInfo.Text = "Place cancelled" end)
            conn1:Disconnect() conn2:Disconnect() conn3:Disconnect()
        end
    end)
    conn2 = mouse.Move:Connect(function()
        if not placeMode then return end
        pcall(function()
            local pos = getMousePos()
            if placeGhost then placeGhost:PivotTo(CFrame.new(pos) * CFrame.Angles(0, math.rad(placeRot), 0)) end
            if placeRange then placeRange.CFrame = CFrame.new(pos) * CFrame.Angles(0,0,math.rad(90)) end
        end)
    end)
    conn3 = mouse.Button1Down:Connect(function()
        if not placeMode then return end
        local pos = getMousePos()
        local isVIPNow = (userTier == "VIP") or isOwner
        local did = false
        if isVIPNow then
            task.wait(math.random(15, 30) / 10)
            did = tryRealPlace(name, pos)
        end
        if did then
            pcall(function() DupeInfo.Text = "Placed REAL: "..name.." (VIP FE) - may Upgrade / Sell na yan" end)
        else
            -- fallback: kung ayaw ng remote, iwan yung ghost as visual, pero sabihin totoo
            pcall(function()
                if placeGhost then
                    for _, pp in ipairs(placeGhost:GetDescendants()) do if pp:IsA("BasePart") then pp.Transparency = 0 end end
                    placeGhost.Parent = SpawnedFolder
                    placeGhost = nil
                end
                if placeRange then placeRange:Destroy() placeRange = nil end
            end)
            if isVIPNow then pcall(function() DupeInfo.Text = "Placed: "..name.." (VIP Visual fallback - remote ayaw, try ulit)" end)
            else pcall(function() DupeInfo.Text = "Placed: "..name.." (FREE Visual) - click ulit para mag-place" end) end
        end
        if did then
            pcall(function() if placeGhost then placeGhost:Destroy() end if placeRange then placeRange:Destroy() end end)
            placeGhost = nil
            placeRange = nil
            placeMode = false
            conn1:Disconnect() conn2:Disconnect() conn3:Disconnect()
        else
            -- visual fallback: start ulit ng bagong ghost para tuloy-tuloy mag-place
            placeMode = false
            conn1:Disconnect() conn2:Disconnect() conn3:Disconnect()
            task.wait(0.2)
            startPlaceMode()
        end
    end)
end
