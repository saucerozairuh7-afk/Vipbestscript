local function findRemote(keywords)
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local n = v.Name:lower()
            for _, k in ipairs(keywords) do if n:find(k) then return v end end
        end
    end
    return nil
end
local function safeFire(rem, ...)
    if not rem then return false end
    local args = {...}
    local ok = pcall(function()
        if rem:IsA("RemoteEvent") then rem:FireServer(unpack(args)) else rem:InvokeServer(unpack(args)) end
    end)
    return ok
end
