local RARITY_COLOR = {Basic=Color3.fromRGB(180,180,180), Rare=Color3.fromRGB(80,180,255), Epic=Color3.fromRGB(180,80,255), Legendary=Color3.fromRGB(255,180,0), Mythic=Color3.fromRGB(255,60,180), Godly=Color3.fromRGB(255,40,40), Ultimate=Color3.fromRGB(0,255,200), Celestial=Color3.fromRGB(150,255,255), Exclusive=Color3.fromRGB(255,255,0), Farm=Color3.fromRGB(0,255,120)}

