local pinilirarity = "Legendary"

-- 3d to pag wala sa game bubuo ako
local function build3DModel(unitName, rarity)
    -- V2: HINDI NA BLOCKS - R15 rig talaga, parang Future Cameraman sa screenshot mo
    -- 1. Try totoong unit model sa TTD mismo (may Humanoid + maraming parts)
    local real = nil
    pcall(function()
        for _, container in ipairs({game:GetService("ReplicatedStorage"), workspace}) do
            for _, f in ipairs(container:GetDescendants()) do
                if f:IsA("Model") and f.Name == unitName and f:FindFirstChildOfClass("Humanoid") then
                    local cnt = 0
                    for _, d in ipairs(f:GetDescendants()) do if d:IsA("BasePart") then cnt = cnt + 1 end end
                    if cnt >= 6 then real = f break end -- buong tao, hindi 1 block
                end
            end
            if real then break end
        end
    end)
    if real then
        local cl = real:Clone()
        pcall(function()
            cl.PrimaryPart = cl:FindFirstChild("HumanoidRootPart") or cl.PrimaryPart
            for _, pp in ipairs(cl:GetDescendants()) do if pp:IsA("BasePart") then pp.Anchored = true pp.CanCollide = false end end
            local hum = cl:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = true end
        end)
        return cl
    end
    -- 2. Fallback: clone yung character mo (R15 rig talaga) tapos gawin Cameraman / Speakerman / TV Man
    -- kaya hindi blocks - may Humanoid + Motor6D na, tulad ng Future Cameraman sa TTD
    local char = plr.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        local cl = char:Clone()
        -- tanggalin accessories / tools para malinis
        pcall(function()
            for _, d in ipairs(cl:GetDescendants()) do
                if d:IsA("Accessory") or d:IsA("Tool") or d:IsA("Decal") or d:IsA("Shirt") or d:IsA("Pants") then d:Destroy() end
            end
            -- suit: itim na torso / arms / legs, parang TTD units
            for _, pp in ipairs(cl:GetDescendants()) do
                if pp:IsA("BasePart") then
                    pp.Anchored = true
                    pp.CanCollide = false
                    if pp.Name:find("Torso") or pp.Name:find("Arm") or pp.Name:find("Leg") then
                        pp.Color = Color3.fromRGB(25,25,30)
                        pp.Material = Enum.Material.SmoothPlastic
                    end
                end
            end
            local hum = cl:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = true hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
            -- head: palitan ng camera / speaker / tv / clock / drill - pero naka-weld sa Head, hindi lumulutang na block
            local head = cl:FindFirstChild("Head")
            if head then
                head.Color = Color3.fromRGB(220,220,220)
                if unitName:lower():find("speaker") then head.Color = Color3.fromRGB(70,70,70)
                elseif unitName:lower():find("tv") then head.Color = Color3.fromRGB(50,50,60)
                elseif unitName:lower():find("clock") then head.Color = Color3.fromRGB(240,220,150)
                elseif unitName:lower():find("drill") then head.Color = Color3.fromRGB(120,90,40) end
                -- lens sa harap ng ulo, naka-weld
                local lens = Instance.new("Part")
                lens.Name = "Lens"
                lens.Size = Vector3.new(0.6, 0.4, 0.15)
                lens.Color = RARITY_COLOR[rarity] or Color3.fromRGB(0,255,255)
                lens.Material = Enum.Material.Neon
                lens.Anchored = true
                lens.CanCollide = false
                lens.CFrame = head.CFrame * CFrame.new(0, 0, -0.55)
                lens.Parent = cl
                local w = Instance.new("WeldConstraint")
                w.Part0 = head
                w.Part1 = lens
                w.Parent = head
                -- drill bit kung Drillman
                if unitName:lower():find("drill") then
                    local bit = Instance.new("Part")
                    bit.Name = "DrillBit"
                    bit.Size = Vector3.new(0.2, 0.8, 0.2)
                    bit.Color = Color3.fromRGB(180,180,180)
                    bit.Material = Enum.Material.Metal
                    bit.Anchored = true
                    bit.CanCollide = false
                    bit.CFrame = head.CFrame * CFrame.new(0, 0, -1.0)
                    bit.Parent = cl
                    local w2 = Instance.new("WeldConstraint")
                    w2.Part0 = head
                    w2.Part1 = bit
                    w2.Parent = head
                end
                -- Titan core sa dibdib
                if unitName:lower():find("titan") then
                    local torso = cl:FindFirstChild("UpperTorso") or cl:FindFirstChild("Torso")
                    if torso then
                        local core = Instance.new("Part")
                        core.Name = "Core"
                        core.Size = Vector3.new(0.5, 0.5, 0.2)
                        core.Color = Color3.fromRGB(0,255,255)
                        core.Material = Enum.Material.Neon
                        core.Anchored = true
                        core.CanCollide = false
                        core.CFrame = torso.CFrame * CFrame.new(0, 0, -0.55)
                        core.Parent = cl
                        local w3 = Instance.new("WeldConstraint")
                        w3.Part0 = torso
                        w3.Part1 = core
                        w3.Parent = torso
                    end
                end
            end
            -- Future Cameraman sword: kung Future / Titan, lagyan ng espada sa kamay
            if unitName:lower():find("future") or unitName:lower():find("titan") then
                local arm = cl:FindFirstChild("Right Arm") or cl:FindFirstChild("RightHand")
                if arm then
                    local sword = Instance.new("Part")
                    sword.Name = "Sword"
                    sword.Size = Vector3.new(0.12, 1.4, 0.3)
                    sword.Color = Color3.fromRGB(0,200,255)
                    sword.Material = Enum.Material.Neon
                    sword.Anchored = true
                    sword.CanCollide = false
                    sword.CFrame = arm.CFrame * CFrame.new(0, -1, -0.4)
                    sword.Parent = cl
                    local w4 = Instance.new("WeldConstraint")
                    w4.Part0 = arm
                    w4.Part1 = sword
                    w4.Parent = arm
                end
            end
        end)
        cl.Name = unitName
        return cl
    end
    -- 3. Last fallback: kung walang character, gumawa ng simple R15-like rig na naka-weld (hindi blocks na nagkalat)
    local model = Instance.new("Model")
    model.Name = unitName
    local function mk(name, size, pos, col)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.Position = pos
        p.Color = col
        p.Anchored = true
        p.CanCollide = false
        p.Parent = model
        return p
    end
    local hrp = mk("HumanoidRootPart", Vector3.new(1,1,1), Vector3.new(0,1.5,0), Color3.fromRGB(255,255,255))
    hrp.Transparency = 1
    model.PrimaryPart = hrp
    local torso = mk("UpperTorso", Vector3.new(1.2,1.2,0.7), Vector3.new(0,1.8,0), Color3.fromRGB(25,25,30))
    local head = mk("Head", Vector3.new(0.9,0.8,0.8), Vector3.new(0,2.8,0), Color3.fromRGB(220,220,220))
    mk("Left Arm", Vector3.new(0.4,1.2,0.4), Vector3.new(-0.9,1.8,0), Color3.fromRGB(25,25,30))
    mk("Right Arm", Vector3.new(0.4,1.2,0.4), Vector3.new(0.9,1.8,0), Color3.fromRGB(25,25,30))
    mk("Left Leg", Vector3.new(0.45,1.0,0.45), Vector3.new(-0.35,0.5,0), Color3.fromRGB(25,25,30))
    mk("Right Leg", Vector3.new(0.45,1.0,0.45), Vector3.new(0.35,0.5,0), Color3.fromRGB(25,25,30))
    for _, pp in ipairs(model:GetChildren()) do
        if pp ~= hrp then
            local w = Instance.new("WeldConstraint")
            w.Part0 = hrp
            w.Part1 = pp
            w.Parent = hrp
        end
    end
    local hum = Instance.new("Humanoid")
    hum.PlatformStand = true
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.Parent = model
    return model
end

local function makeViewport(parent, unitName, rarity, size, doSpin)
    local vp = Instance.new("ViewportFrame")
    vp.Size = size or UDim2.new(0, 70, 0, 70)
    vp.BackgroundColor3 = Color3.fromRGB(220,220,230)
    vp.BackgroundTransparency = 0
    -- fix itim: lagyan ng ilaw
    pcall(function()
        vp.LightColor = Color3.fromRGB(255,255,255)
        vp.LightDirection = Vector3.new(0, -1, -1)
        vp.Ambient = Color3.fromRGB(180,180,180)
    end)
    vp.BorderSizePixel = 0
    vp.ZIndex = 10
    vp.Parent = parent
    local vc = Instance.new("UICorner") vc.CornerRadius = UDim.new(0,10) vc.Parent = vp
    -- FIX: wag na mag-clone ng real model - yun yung nagiging block
    -- dati kasi pag may nahanap na "Cameraman" sa game, isang block lang yun, yun yung ni-clone
    -- kaya laging blocks. Ngayon laging build3DModel na lang, buong tao talaga
    local model = build3DModel(unitName, rarity)
    pcall(function() for _, pp in ipairs(model:GetDescendants()) do if pp:IsA("BasePart") then pp.Anchored = true pp.CanCollide = false end end end) -- kahit real model, i-anchor para hindi magkalat
    model.Parent = vp
    local cam = Instance.new("Camera")
    cam.Parent = vp
    vp.CurrentCamera = cam
    local cf = CFrame.new(0, 1.8, 0) -- fixed center, hindi na bounding box (yun yung nagpa-liit sa "1")
    local center = cf.Position
    local dist = 6.5 -- fixed distance, laging kita buong tao
    cam.CFrame = CFrame.new(center + Vector3.new(2.2, 1.2, dist), center) -- angled, hindi flat kaya hindi mukhang poste
    -- paikot
    if doSpin then task.spawn(function()
        local a = 0
        while vp.Parent do
            a = a + 0.02
            pcall(function() model:PivotTo(CFrame.new(center) * CFrame.Angles(0, a, 0)) end)
            task.wait(0.03)
        end
    end) end
    return vp
end

